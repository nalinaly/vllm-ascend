+@pytest.mark.parametrize("name,width", [("cmp_wgate", 1024), ("inner_wkv", 256)])
+@pytest.mark.parametrize("target_layout", ["ND", "NZ"])
+def test_legacy_compressor_gate_snapshot_migrates_both_ways(name, width, target_layout):
+    from vllm_ascend.ops.pypto.deepseek_v4_flash_dspark.native_adapter import _unpack_nz
+
+    gate = (torch.arange(width * 4096).reshape(width, 4096) % 97).to(torch.bfloat16)
+    roles, source = {name: "in"}, {"state_timing": "before_call"}
+    meta, payload = capture_tensors({name: gate}, roles, {}, source)
+    values, _ = materialize(meta, payload)
+    shapes = {name: (width, 4096)}
+    converted, names = convert_weight_layouts(values, meta, {name: target_layout}, shapes)
+    assert names == ([name] if target_layout == "NZ" else [])
+    actual = _unpack_nz(converted[name]) if target_layout == "NZ" else converted[name]
+    assert torch.equal(actual, gate)
+    if target_layout == "ND":
+        assert converted[name] is values[name]
+    new_meta, new_payload = capture_tensors(converted, roles, {name: target_layout}, source)
+    new_values, _ = materialize(new_meta, new_payload)
+    unchanged, names = convert_weight_layouts(new_values, new_meta, {name: target_layout}, shapes)
+    assert names == [] and unchanged[name] is new_values[name]
+    precision, names = convert_weight_layouts(new_values, new_meta, {name: "ND"}, shapes)
+    assert torch.equal(precision[name], gate)
+
