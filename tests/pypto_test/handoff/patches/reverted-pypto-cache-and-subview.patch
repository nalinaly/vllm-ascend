diff --git a/tests/ut/codegen/test_ptoas_planner_views.py b/tests/ut/codegen/test_ptoas_planner_views.py
index 89cbeac..de2a4ad 100644
--- a/tests/ut/codegen/test_ptoas_planner_views.py
+++ b/tests/ut/codegen/test_ptoas_planner_views.py
@@ -181,6 +181,31 @@ def test_inplace_alias_keeps_shared_handle_definition_type():
     assert store_types == alloc_types, f"{alloc}\n{store}"
 
 
+@pl.program
+class InheritedDynamicSliceProgram:
+    @pl.function(type=pl.FunctionType.InCore)
+    def kernel(
+        self,
+        x: pl.Tensor[[8, 64], pl.FP32],
+        valid_rows: pl.Scalar[pl.INDEX],
+        out: pl.Out[pl.Tensor[[8, 32], pl.FP32]],
+    ) -> pl.Tensor[[8, 32], pl.FP32]:
+        source = pl.load(x, [0, 0], [8, 64], valid_shape=[valid_rows, 64], target_memory=pl.MemorySpace.Vec)
+        window = pl.tile.slice(source, [8, 32], [0, 32])
+        return pl.store(window, [0, 0], out)
+
+
+@pytest.mark.parametrize("planner", [passes.MemoryPlanner.PYPTO, passes.MemoryPlanner.PTOAS])
+def test_subview_emits_inherited_dynamic_valid_extent(planner):
+    """The inferred window validity must reach PTOAS, not just its result type."""
+    mlir = _emit_pto(InheritedDynamicSliceProgram, planner)
+    subview = _sole_line(mlir, "pto.subview")
+    assert re.search(r"valid \[%\w+, %c32_index\]", subview), subview
+    assert "v_row=?, v_col=32" in _result_type(subview), subview
+    store = _sole_line(mlir, "pto.tstore")
+    assert _result_type(subview) in store, f"{subview}\n{store}"
+
+
