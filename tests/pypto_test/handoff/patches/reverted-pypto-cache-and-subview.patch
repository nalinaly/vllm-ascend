diff --git a/tests/ut/jit/test_toolchain_inventory.py b/tests/ut/jit/test_toolchain_inventory.py
index 084688f..81c0f05 100644
--- a/tests/ut/jit/test_toolchain_inventory.py
+++ b/tests/ut/jit/test_toolchain_inventory.py
@@ -19,6 +19,34 @@ from pypto._identity import fingerprint_content
 from pypto.jit import _toolchain
 
 
+def test_package_inventory_covers_all_declared_roots(tmp_path, monkeypatch):
+    source = tmp_path / "source/package"
+    installed = tmp_path / "installed/package"
+    source.mkdir(parents=True)
+    installed.mkdir(parents=True)
+    init = source / "__init__.py"
+    init.write_text("")
+    native = installed / "extension.so"
+    native.write_bytes(b"\x7fELF")
+    dependency = tmp_path / "libcompiler.so"
+    dependency.write_bytes(b"\x7fELF")
+    package = SimpleNamespace(__file__=str(init), __path__=[str(source), str(installed)])
+    monkeypatch.setitem(sys.modules, "inventory_split_package", package)
+    monkeypatch.setitem(
+        sys.modules, "inventory_split_package.extension", SimpleNamespace(__file__=str(native))
+    )
+    monkeypatch.setattr(_toolchain, "_elf_inputs", lambda path: {path, dependency})
+    assert _toolchain._package("inventory_split_package") == {source, installed, native, dependency}
+
+    outside = tmp_path / "untracked.py"
+    outside.write_text("not_a_package_dependency = True\n")
+    monkeypatch.setitem(
+        sys.modules, "inventory_split_package.redirect", SimpleNamespace(__file__=str(outside))
+    )
+    with pytest.raises(ValueError, match="external import redirect"):
+        _toolchain._package("inventory_split_package")
+
+
