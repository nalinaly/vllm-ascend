# Historical tensor payloads are preserved locally; SHA256 and paths are in
# handoff/MIGRATION_PROCESS_FILES.json. Text reports and profiler records stay in Git.
results/**/*.pt
# Offline P/D tensor banks follow the same local-payload policy.
results/**/*.safetensors
results/**/*.safetensors.tmp
# Device binaries and build packages stay local.
results/**/*.bin
results/**/*.so
results/**/*.so.*
results/**/*.o
results/**/*.a
results/**/*.run
results/**/*.whl
# Regenerable long prompts and compiler intermediates stay local. Selected
# textual evidence can be explicitly tracked; paths/sizes are in LOCAL_ARTIFACTS.json.
results/**/full_bank/*.tokens.json
results/**/incore/
results/**/ptoas/
results/**/orchestration/
results/**/kernel_config.py
results/**/pto_bf16_norm_codegen/debug/
results/**/pto_bf16_norm_codegen/kernels/
results/**/updated_codegen/debug/
results/**/updated_codegen/kernels/
